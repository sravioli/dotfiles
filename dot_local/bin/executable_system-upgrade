#!/bin/sh
# Upgrades packages, fish plugins, nvim plugins, uv tools, oh-my-posh, cleans up, re-patches Spotify with spicetify if it was updated, lists unmerged .pacnew files, and updates firmware last.
set -e
spotify_version() { pacman -Q spotify 2>/dev/null || true; }
before=$(spotify_version)
yay -Syu
yay -Ycc
sudo paccache -r
fish -c "fisher update"
nvim --headless "+Lazy! sync" +qa
uv tool upgrade --all
if command -v oh-my-posh >/dev/null; then oh-my-posh upgrade; fi
after=$(spotify_version)
if [ -n "$after" ] && [ "$before" != "$after" ] && command -v spicetify >/dev/null; then
    echo "spotify updated ($before -> $after); reapplying spicetify"
    # the update replaced the patched files, so make them writable again and back up the fresh ones
    sudo chmod a+wr /opt/spotify && sudo chmod -R a+wr /opt/spotify/Apps
    spicetify -n backup apply
fi
pacnew=$(find /etc -name '*.pacnew' 2>/dev/null)
[ -z "$pacnew" ] || printf 'unmerged .pacnew files (merge with pacdiff):\n%s\n' "$pacnew"
# fwupdmgr exits 2 when there is nothing to refresh or update
if command -v fwupdmgr >/dev/null; then
    fwupdmgr refresh || true
    fwupdmgr update || true
fi
