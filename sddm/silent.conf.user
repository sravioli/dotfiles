# SilentSDDM overrides, layered by SDDM on top of the theme's configs/default.conf.
# Copied to /usr/share/sddm/themes/silent/configs/default.conf.user by set-sddm-theme.sh.
# Colours: Kanagawa wave. Text fujiWhite, accent crystalBlue, surfaces sumiInk.
# Options: /usr/share/sddm/themes/silent/docs/Options.md

[General]
showClock=true
type=image

[LockScreen]
background-color="#1F1F28"

[LockScreen.Clock]
color="#DCD7BA"

[LockScreen.Date]
color="#C8C093"

[LockScreen.Message]
color="#DCD7BA"

[LoginScreen]
background-color="#1F1F28"

[LoginScreen.LoginArea.Avatar]
active-border-color="#7E9CD8"
inactive-border-color="#938AA9"

[LoginScreen.LoginArea.Username]
color="#DCD7BA"

[LoginScreen.LoginArea.PasswordInput]
content-color="#DCD7BA"
background-color="#1F1F28"
border-color="#7E9CD8"

[LoginScreen.LoginArea.LoginButton]
background-color="#1F1F28"
active-background-color="#7E9CD8"
content-color="#DCD7BA"
active-content-color="#1F1F28"
border-color="#7E9CD8"

[LoginScreen.LoginArea.Spinner]
color="#7E9CD8"

[LoginScreen.LoginArea.WarningMessage]
normal-color="#DCD7BA"
warning-color="#FF9E3B"
error-color="#E82424"

[LoginScreen.MenuArea.Popups]
background-color="#1F1F28"
active-option-background-color="#2D4F67"
content-color="#DCD7BA"
active-content-color="#7E9CD8"
border-color="#54546D"

[LoginScreen.MenuArea.Session]
background-color="#1F1F28"
content-color="#DCD7BA"
active-content-color="#7E9CD8"

[LoginScreen.MenuArea.Layout]
background-color="#1F1F28"
content-color="#DCD7BA"
active-content-color="#7E9CD8"

[LoginScreen.MenuArea.Keyboard]
background-color="#1F1F28"
content-color="#DCD7BA"
active-content-color="#7E9CD8"

[LoginScreen.MenuArea.Power]
background-color="#1F1F28"
content-color="#DCD7BA"
active-content-color="#7E9CD8"

[LoginScreen.VirtualKeyboard]
background-color="#16161D"
key-content-color="#DCD7BA"
key-color="#2A2A37"
key-active-background-color="#363646"
selection-background-color="#7E9CD8"
selection-content-color="#1F1F28"
border-color="#16161D"

[Tooltips]
content-color="#DCD7BA"
background-color="#1F1F28"
