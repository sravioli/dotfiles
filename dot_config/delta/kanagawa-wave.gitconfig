# Kanagawa Wave - delta theme
# https://github.com/rebelot/kanagawa.nvim
#
# Usage:
#   [include]
#       path = /path/to/extras/delta/kanagawa-wave.gitconfig
#   [delta]
#       features = kanagawa-wave

[delta "kanagawa-wave"]
  dark = true
  syntax-theme = Kanagawa Wave
    # Diff
  minus-style = syntax "#43242B"
  minus-non-emph-style = syntax "#43242B"
  minus-emph-style = bold "#C34043" "#43242B"
  minus-empty-line-marker-style = normal "#3f0001"
  zero-style = syntax
  plus-style = syntax "#2B3328"
  plus-non-emph-style = syntax "#2B3328"
  plus-emph-style = bold "#76946A" "#2B3328"
  plus-empty-line-marker-style = normal "#002800"
  whitespace-error-style = reverse "#E82424"
    # Commit and file
  commit-style = bold italic "#7E9CD8"
  commit-decoration-style = none
  file-style = bold "#E6C384"
  file-decoration-style = "#54546D" ul
  file-added-label = [+]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [→]
  file-copied-label = [C]
    # Hunk header
  hunk-header-style = syntax
  hunk-header-decoration-style = "#54546D" ul
  hunk-header-file-style = "#E6C384"
  hunk-header-line-number-style = "#957FB8"
    # Line numbers
  line-numbers = true
  line-numbers-left-format = " {nm:>3} │"
  line-numbers-right-format = " {np:>3} │"
  line-numbers-left-style = "#2A2A37"
  line-numbers-right-style = "#2A2A37"
  line-numbers-minus-style = bold "#C34043"
  line-numbers-plus-style = bold "#76946A"
  line-numbers-zero-style = italic "#54546D"
    # Blame
  blame-palette = "#16161D" "#1a1a22" "#1F1F28" "#2A2A37"
  blame-code-style = syntax
  blame-separator-style = "#727169"
  blame-format = "{author:<18} ({commit:>7}) │{timestamp:^16}│ "
    # Merge conflicts
  merge-conflict-begin-symbol = ~
  merge-conflict-end-symbol = ~
  merge-conflict-ours-diff-header-style = "#E6C384" bold
  merge-conflict-ours-diff-header-decoration-style = "#54546D" box
  merge-conflict-theirs-diff-header-style = "#E6C384" bold
  merge-conflict-theirs-diff-header-decoration-style = "#54546D" box
