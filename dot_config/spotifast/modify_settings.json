#!/bin/sh
# Merges only the Kanagawa theme keys into Spotifast's settings.json; the app rewrites the rest (search history, window sizes, client id).
# shortcut: needs jq (in the package list), and starts from {} on a fresh install, relying on Spotifast to fill defaults; revisit if it rejects a sparse file
in=$(cat)
[ -n "$in" ] || in='{}'
printf '%s' "$in" | jq --argjson pair '{"dark":{"filename":"Kanagawa Wave.json","palette":{"dark":true,"window":[31,31,40,255],"panel":[26,26,34,255],"surface":[42,42,55,255],"surface_hover":[54,54,70,255],"surface_active":[34,50,73,255],"outline":[54,54,70,255],"text":[220,215,186,255],"secondary":[200,192,147,255],"dim":[114,113,105,255],"accent":[126,156,216,255],"accent_hover":[127,180,202,255],"on_accent":[31,31,40,255],"danger":[232,36,36,255],"warning":[255,158,59,255],"overlay":[46,46,52,255],"shadow":[0,0,0,140],"tint":[0,0,0,0]}}}' '.theme_pair = $pair | .skin = "Kanagawa Wave Tall.wmz" | .skin_scale = 2'
