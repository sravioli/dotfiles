#!/bin/sh
# Login screen theme lives in /etc and /usr (outside chezmoi). Writes to kde_settings.conf, the file
# System Settings > Login Screen uses, so the theme can still be changed from there.
# Presets come from kanagawa-community/silent-sddm, pinned: bump VERSION to update (re-runs this script).
set -e
VERSION=1.0.0

# Active SilentSDDM preset: kanagawa-wave, kanagawa-dragon or kanagawa-lotus
preset=kanagawa-dragon

# newer CachyOS ISOs (e.g. 260809) ship Plasma Login Manager; --force swaps the display-manager.service link to SDDM (takes effect next boot)
sudo systemctl enable --force sddm.service

theme=/usr/share/sddm/themes/silent
[ -d "$theme" ] || { echo "sddm-silent-theme not installed; skipping login screen theme"; exit 0; }
sudo kwriteconfig6 --file /etc/sddm.conf.d/kde_settings.conf --group Theme --key Current silent

src=$(mktemp -d)
trap 'rm -rf "$src"' EXIT
curl -fsSL "https://codeload.github.com/kanagawa-community/silent-sddm/tar.gz/refs/tags/$VERSION" | tar -xz -C "$src" --strip-components=1
# its install.sh also points metadata.desktop (a pacman backup file, so it survives upgrades) at the preset
# last: install all three so any can be picked from there, the chosen one last so it stays active
for v in wave dragon lotus "${preset#kanagawa-}"; do "$src/install.sh" "$v"; done
