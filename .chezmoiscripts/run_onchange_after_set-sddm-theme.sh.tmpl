#!/bin/sh
# Login screen theme lives in /etc and /usr (outside chezmoi). Writes to kde_settings.conf, the file
# System Settings > Login Screen uses, so the theme can still be changed from there.
# Re-runs when any file under sddm/ changes:
{{- range glob (joinPath .chezmoi.sourceDir "sddm/*/*") }}
# {{ base . }}: {{ include . | sha256sum }}
{{- end }}

# Active SilentSDDM preset: kanagawa-dragon or kanagawa-lotus (files in sddm/configs/)
preset=kanagawa-dragon

# newer CachyOS ISOs (e.g. 260809) ship Plasma Login Manager; --force swaps the display-manager.service link to SDDM (takes effect next boot)
sudo systemctl enable --force sddm.service

theme=/usr/share/sddm/themes/silent
[ -d "$theme" ] || { echo "sddm-silent-theme not installed; skipping login screen theme"; exit 0; }
sudo kwriteconfig6 --file /etc/sddm.conf.d/kde_settings.conf --group Theme --key Current silent
# metadata.desktop is a pacman backup file, so the preset choice survives upgrades
sudo sed -i "s|^ConfigFile=.*|ConfigFile=configs/$preset.conf|" "$theme/metadata.desktop"
# both presets are installed so either can be picked; the theme only loads backgrounds from its own backgrounds/ folder
sudo install -m 644 "{{ .chezmoi.sourceDir }}"/sddm/configs/* "$theme/configs/"
sudo install -m 644 "{{ .chezmoi.sourceDir }}"/sddm/backgrounds/* "$theme/backgrounds/"
