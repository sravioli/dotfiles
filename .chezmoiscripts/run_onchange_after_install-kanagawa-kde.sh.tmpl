#!/bin/sh
# Kanagawa for KDE Plasma (kanagawa-community/kde, pinned: bump VERSION to update; re-runs this script).
# Installs the colour schemes, Plasma styles, window decorations, global themes and wallpapers into
# ~/.local/share, plus its cursors, icons, Konsole and Kate ports (cloned unpinned, needs git).
# It doesn't apply a theme: pick one in System Settings or run
#   plasma-apply-lookandfeel -a org.kanagawa-community.wave   (or dragon, lotus)
set -e
VERSION=1.0.0

src=$(mktemp -d)
trap 'rm -rf "$src"' EXIT
curl -fsSL "https://codeload.github.com/kanagawa-community/kde/tar.gz/refs/tags/$VERSION" | tar -xz -C "$src" --strip-components=1
"$src/install.sh" all
